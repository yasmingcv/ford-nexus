{
  "rules": {
    ".read": false,
    ".write": false,

    "conversationMembers": {
      "$conversationId": {
        ".read": "auth != null && data.child(auth.uid).val() === true",
        ".write": false
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null && root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true",
        ".indexOn": ["createdAt"],

        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('conversationMembers').child($conversationId).child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['conversationId', 'conversationType', 'senderId', 'text', 'target', 'createdAt'])",

          "conversationId": { ".validate": "newData.val() === $conversationId" },
          "conversationType": {
            ".validate": "($conversationId.beginsWith('dm_') && newData.val() === 'direct') || (!$conversationId.beginsWith('dm_') && newData.val() === 'group')"
          },
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "target": {
            ".validate": "newData.hasChild('type')",
            "type": { ".validate": "newData.val() === 'conversation' || newData.val() === 'member'" },
            "memberId": {
              ".validate": "newData.isString() && root.child('conversationMembers').child($conversationId).child(newData.val()).val() === true"
            },
            "$other": { ".validate": false }
          },
          "mentionedUserIds": {
            "$index": {
              ".validate": "newData.isString() && root.child('conversationMembers').child($conversationId).child(newData.val()).val() === true"
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
