rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /images/users/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImage();
    }

    // Somente o proprietário do grupo (conferido no Firestore) altera a foto.
    match /images/groups/{groupId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isImage()
        && firestore.get(/databases/(default)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }
  }
}
